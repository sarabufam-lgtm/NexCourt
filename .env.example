# ==============================================================================
# NexCourt Environment Configuration Template
# Copy this file to .env in local development. Never commit .env to source control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexcourt?schema=public

# Security & Authentication Secrets (Minimum 32 characters each)
JWT_SECRET=replace_with_a_super_secure_random_string_min_32_chars_for_jwt
JWT_REFRESH_SECRET=replace_with_another_secure_string_min_32_chars_for_refresh
COOKIE_SECRET=replace_with_cookie_secret_string_32_chars

# Client / CORS URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Concurrency & Booking Leases
SLOT_LOCK_TIMEOUT_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional Notification Integrations (Twilio / SendGrid)
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
